{
  "name": "pw-educamos-notifier",
  "version": "1.0.0",
  "description": "A Playwright-based bot that polls the CLM Educamos platform and forwards received messages to Telegram using PageObject model",
  "main": "app.ts",
  "scripts": {
    "setup": "npm install && npx playwright install-deps && npx playwright install",
    "once": "NODE_PATH=./src ts-node app.ts",
    "start-service": "NODE_PATH=./src ts-node app.ts schedule",
    "pogen-inline": "npx ts-node tools/po-codegen-inline.ts"
  },
  "keywords": [
    "playwright",
    "educamos",
    "telegram",
    "bot"
  ],
  "author": "Daniel Garcia <dev@danigarcia.org>",
  "license": "GNU GPLv3",
  "devDependencies": {
    "@types/node": "^24.0.3"
  },
  "dependencies": {
    "@playwright/test": "^1.53.1",
    "axios": "^1.10.0",
    "dotenv": "^16.5.0",
    "html-to-text": "^9.0.5",
    "node-cron": "^4.1.1",
    "pino": "^9.7.0",
    "playwright": "^1.53.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
